# Arbitrum RPC endpoint used by `sas analyze` for live deploy-cost estimation.
# OPTIONAL. If unset, analyze falls back to the public endpoint below, which means
# the cost step makes a network call to a third party you did not choose. Set this
# to your own endpoint (Alchemy, Infura, a local node) to avoid that, or pass
# --no-cost to skip the network entirely.
#
# Every other command works offline and ignores this variable.
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
